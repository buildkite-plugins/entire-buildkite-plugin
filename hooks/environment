#!/usr/bin/env bash
set -euo pipefail

if [[ ! ${BUILDKITE_REPO:-} =~ ^entire://[a-zA-Z0-9.-]+(:[0-9]+)?/[^[:space:]?#]+$ ]]; then
  echo 'Entire: BUILDKITE_REPO must be a native entire:// repository URL.' >&2
  exit 1
fi

# v0.11.5 commit build validated against the environment-token flow.
commit=4b8cdfaf0d15e236835c3b7c85d8803b112574bc
export PATH="${HOME}/.local/bin:${PATH}"

helper_is_current() {
  local version
  version="$(git-remote-entire --version 2>/dev/null)" || return 1
  version="${version%%$'\n'*}"
  case "$version" in
    "git-remote-entire 0.0.0+$commit") return 0 ;;
  esac
  # Unknown development builds cannot be ordered by commit hash.
  [[ $version =~ ^git-remote-entire\ ([0-9]+\.[0-9]+\.[0-9]+)(\+[^[:space:]]+)?$ ]] &&
    printf '%s\n' 0.11.5 "${BASH_REMATCH[1]}" | sort -V -C
}

if ! helper_is_current; then
  (
    if [[ $(uname -s) != Linux ]]; then
      echo 'Entire: automatic installation supports Linux only; provision a supported git-remote-entire on PATH.' >&2
      exit 1
    fi
    case "$(uname -m)" in
      x86_64|amd64)
        arch=amd64
        checksum=11643ca11f402ee8b78f552d43aedac8fac2208973bfde2cb354d3a388bedafb ;;
      aarch64|arm64)
        arch=arm64
        checksum=5e2ddb7818ec6547aaf55fbf1c389d6a5bc135241558a9b27fa17ce30bb64bc7 ;;
      *) echo 'Entire: automatic installation supports amd64 and arm64 only.' >&2; exit 1 ;;
    esac

    echo '~~~ :package: Installing git-remote-entire'
    mkdir -p "$HOME/.local/bin"
    directory="$(mktemp -d "$HOME/.local/bin/.entire.XXXXXXXX")"
    trap 'rm -rf -- "$directory"' EXIT
    curl -q --fail --silent --show-error --location --proto '=https' --proto-redir '=https' \
      --connect-timeout 15 --max-time 180 --retry 2 \
      "https://entire-public-release-bucket-7f3e2a01c9b48d56.s3.us-east-2.amazonaws.com/commit/${commit}/git-remote-entire_linux_${arch}.tar.gz" \
      --output "$directory/helper.tar.gz"
    printf '%s  %s\n' "$checksum" "$directory/helper.tar.gz" \
      | sha256sum --check --status || { echo 'Entire: release checksum mismatch.' >&2; exit 1; }
    tar -xzf "$directory/helper.tar.gz" -C "$directory" git-remote-entire
    # Same-filesystem rename preserves a working helper if installation fails.
    mv -f "$directory/git-remote-entire" "$HOME/.local/bin/git-remote-entire"
  )
fi

# Wrap the helper for this job so a failed checkout explains its credentials.
# The state directory never holds a token; hooks/pre-exit removes it.
plugin=$(cd "${BASH_SOURCE[0]%/*}/.." && pwd)
# shellcheck source=lib/guidance.bash
source "$plugin/lib/guidance.bash"
ENTIRE_BUILDKITE_PLUGIN_STATE=$(mktemp -d "${TMPDIR:-/tmp}/entire-buildkite-plugin.XXXXXXXX")
export ENTIRE_BUILDKITE_PLUGIN_STATE
command -v git-remote-entire > "$ENTIRE_BUILDKITE_PLUGIN_STATE/helper"
export PATH="$plugin/bin:$PATH"

# Preserve operator credentials; otherwise try Buildkite on any agent type.
# Even testing an existing token must happen with tracing disabled.
entire_trace=$-
set +x
entire_source=none
entire_reason=
if [[ -n ${ENTIRE_TOKEN:-} ]]; then
  entire_source=supplied
  echo 'Entire: Using ENTIRE_TOKEN from the agent environment; not requesting credentials from Buildkite.'
else
  repository=${BUILDKITE_REPO#entire://}
  errors="$ENTIRE_BUILDKITE_PLUGIN_STATE/agent-errors"
  # The agent exposes repository credentials through this internal command.
  # Call it once, not through Git. The issuer authorizes the exact HTTPS alias.
  # Stdout holds the password and is never printed. Stderr holds the agent's
  # log line with Buildkite's reason; it is shown below, bounded and redacted.
  if command -v buildkite-agent >/dev/null; then
    entire_output=$(printf 'protocol=https\nhost=%s\npath=%s\n\n' "${repository%%/*}" "${repository#*/}" \
      | BUILDKITE_AGENT_NO_COLOR=true BUILDKITE_AGENT_DEBUG=false BUILDKITE_AGENT_LOG_LEVEL=notice \
        buildkite-agent git-credentials-helper get 2>"$errors") && entire_status=0 || entire_status=$?
  else
    entire_output='' entire_status=127
    echo 'buildkite-agent is not on PATH.' > "$errors"
  fi
  ENTIRE_TOKEN=$(printf '%s\n' "$entire_output" | sed -n 's/^password=//p')
  if (( entire_status == 0 )) && [[ -n $ENTIRE_TOKEN && $ENTIRE_TOKEN != *[[:space:]]* ]]; then
    # Presence selects Entire's fixed-bearer path, with no login fallback.
    export ENTIRE_TOKEN
    entire_source=issued
    echo 'Entire: Using checkout credentials issued by Buildkite.'
  else
    # Issuance is optional: a saved login or other agent setup may still work.
    entire_message=$(head -c 4096 "$errors" | sed -e 's/\x1b\[[0-9;]*[A-Za-z]//g' -e 's/[[:cntrl:]]//g' \
      -e 's/\. Authentication will proceed, but will fail\.$/./' | head -n 10)
    # Defense in depth: the agent does not print credentials to stderr.
    [[ ${#ENTIRE_TOKEN} -ge 8 ]] && entire_message=${entire_message//"$ENTIRE_TOKEN"/[REDACTED]}
    [[ -n ${BUILDKITE_AGENT_ACCESS_TOKEN:-} ]] &&
      entire_message=${entire_message//"$BUILDKITE_AGENT_ACCESS_TOKEN"/[REDACTED]}
    unset ENTIRE_TOKEN
    case $entire_message in
      *"400 Bad Request: Can't issue repository access token: Entire code access requires"*) entire_reason=opt-in ;;
      *'400 Bad Request: Repository provider refused to issue token'*) entire_reason=provider ;;
      *"400 Bad Request: Can't issue repository access token: Requested repository does not match"*) entire_reason=repository ;;
      *) entire_reason=unknown ;;
    esac
    {
      echo '+++ :warning: Entire: Buildkite did not issue checkout credentials'
      if (( entire_status == 0 )); then
        echo 'Entire: buildkite-agent git-credentials-helper returned no usable token.'
      else
        echo "Entire: buildkite-agent git-credentials-helper failed (exit ${entire_status}):"
      fi
      if [[ -n $entire_message ]]; then
        while IFS= read -r line; do echo "Entire:   $line"; done <<< "$entire_message"
      elif (( entire_status != 0 )); then
        echo 'Entire:   (the agent gave no reason)'
      fi
      echo 'Entire: Continuing without ENTIRE_TOKEN. Checkout can still use a saved Entire login or other agent configuration.'
    } >&2
    unset entire_message line
  fi
  unset repository errors entire_output entire_status
fi
printf 'source=%s\nreason=%s\n' "$entire_source" "$entire_reason" > "$ENTIRE_BUILDKITE_PLUGIN_STATE/credentials"
case $entire_trace in
  *x*) unset entire_trace; set -x ;;
  *) unset entire_trace ;;
esac

# v0.11.5 removed the helper's opt-out. Keep jobs from using a saved identity
# when it was explicitly forbidden. Test presence, never the secret value.
if [[ ! ${ENTIRE_TOKEN+x} ]]; then
  case ${ENTIRE_GIT_NO_LOGIN_FALLBACK-false} in
    1|t|T|true|TRUE|True)
      entire_guidance guard >&2
      exit 1 ;;
    0|f|F|false|FALSE|False) ;;
    *) echo 'Entire: ENTIRE_GIT_NO_LOGIN_FALLBACK must be a boolean (true or false).' >&2; exit 1 ;;
  esac
fi
unset plugin entire_source entire_reason
