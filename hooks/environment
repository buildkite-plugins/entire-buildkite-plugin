#!/usr/bin/env bash
set -euo pipefail

if [[ ! ${BUILDKITE_REPO:-} =~ ^entire://[a-zA-Z0-9.-]+(:[0-9]+)?/[^[:space:]?#]+$ ]]; then
  echo 'Entire: BUILDKITE_REPO must be a native entire:// repository URL.' >&2
  exit 1
fi

# v0.11.6 commit artifacts verified as built with Go 1.27.3 (CVE-2026-111943).
commit=fedd31ca105b27e2bc57b60caa304aab82a39f25
export PATH="${HOME}/.local/bin:${PATH}"

# Only reuse verified executables. A reported release version cannot establish
# which Go compiler built a PATH/cache installation. No host Go is required.
case "$(uname -s)/$(uname -m)" in
  Linux/x86_64|Linux/amd64)
    arch=amd64
    checksum=dafe35ea12509661d878a28ff07ba7bc8e632c69e9ed40acf913aa5182042866
    helper_checksum=df202c78779217cf06da8b6bb62d64a5e242b874bfa1618692e720689d598392 ;;
  Linux/aarch64|Linux/arm64)
    arch=arm64
    checksum=3e63494fd4a7633aecdcb6ffab1270a9159f7a30aec311107a903b5dbef81f2a
    helper_checksum=ca718fbd7430f7c9c8b0b7d5e5549ae6bd04ddc9b00259ccce59a47109ebaf4d ;;
  *) echo 'Entire: verified helper installation supports Linux amd64 and arm64 only.' >&2; exit 1 ;;
esac

helper_is_current() {
  local helper
  helper="$(command -v git-remote-entire)" || return 1
  [[ -f $helper && -x $helper ]] || return 1
  printf '%s  %s\n' "$helper_checksum" "$helper" | sha256sum --check --status
}

if ! helper_is_current; then
  (
    echo '~~~ :package: Installing git-remote-entire'
    mkdir -p "$HOME/.local/bin"
    directory="$(mktemp -d "$HOME/.local/bin/.entire.XXXXXXXX")"
    trap 'rm -rf -- "$directory"' EXIT
    curl -q --fail --silent --show-error --location --proto '=https' --proto-redir '=https' \
      --connect-timeout 15 --max-time 180 --retry 2 \
      "https://entire-public-release-bucket-7f3e2a01c9b48d56.s3.us-east-2.amazonaws.com/commit/${commit}/git-remote-entire_linux_${arch}.tar.gz" \
      --output "$directory/helper.tar.gz"
    printf '%s  %s\n' "$checksum" "$directory/helper.tar.gz" \
      | sha256sum --check --status || { echo 'Entire: release checksum mismatch.' >&2; exit 1; }
    tar -xzf "$directory/helper.tar.gz" -C "$directory" git-remote-entire
    printf '%s  %s\n' "$helper_checksum" "$directory/git-remote-entire" \
      | sha256sum --check --status || { echo 'Entire: executable checksum mismatch.' >&2; exit 1; }
    # Same-filesystem rename preserves a working helper if installation fails.
    mv -f "$directory/git-remote-entire" "$HOME/.local/bin/git-remote-entire"
  )
fi

# Preserve operator credentials; otherwise try Buildkite on any agent type.
# Even testing an existing token must happen with tracing disabled.
entire_trace=$-
set +x
if [[ -z ${ENTIRE_TOKEN:-} ]]; then
  repository=${BUILDKITE_REPO#entire://}
  # The agent exposes repository credentials through this internal command.
  # Call it once, not through Git. The issuer authorizes the exact HTTPS alias.
  # Suppress diagnostics: an error response could contain credential material.
  if ENTIRE_TOKEN=$(printf 'protocol=https\nhost=%s\npath=%s\n\n' "${repository%%/*}" "${repository#*/}" \
    | buildkite-agent git-credentials-helper get 2>/dev/null \
    | sed -n 's/^password=//p') && [[ -n $ENTIRE_TOKEN && $ENTIRE_TOKEN != *[[:space:]]* ]]; then
    # Presence selects Entire's fixed-bearer path, with no login fallback.
    export ENTIRE_TOKEN
  else
    # Issuance is optional. Leave saved-login and fallback policy untouched.
    unset ENTIRE_TOKEN
    organization=${BUILDKITE_ORGANIZATION_SLUG:-}
    [[ $organization =~ ^[A-Za-z0-9][A-Za-z0-9-]*$ ]] || organization='~'
    {
      echo '+++ :warning: Entire: No checkout credentials from Buildkite'
      echo 'Entire: If checkout fails, check the Entire repository connection and access permissions:'
      echo "Entire: https://buildkite.com/organizations/${organization}/repository-providers"
      if [[ ${BUILDKITE_COMPUTE_TYPE:-} != hosted ]]; then
        echo 'Entire: For self-hosted agents, also check "Allow self-hosted agents to use checkout credentials".'
      fi
      echo 'Entire: A supplied ENTIRE_TOKEN or a saved Entire login on the agent can also provide authentication.'
    } >&2
    unset organization
  fi
  unset repository
fi
case $entire_trace in
  *x*) unset entire_trace; set -x ;;
  *) unset entire_trace ;;
esac

# v0.11.5 removed the helper's opt-out. Keep jobs from using a saved identity
# when it was explicitly forbidden. Test presence, never the secret value.
if [[ ! ${ENTIRE_TOKEN+x} ]]; then
  case ${ENTIRE_GIT_NO_LOGIN_FALLBACK-false} in
    1|t|T|true|TRUE|True)
      echo 'Entire: saved-login fallback is disabled; supply ENTIRE_TOKEN.' >&2
      exit 1 ;;
    0|f|F|false|FALSE|False) ;;
    *) echo 'Entire: ENTIRE_GIT_NO_LOGIN_FALLBACK must be a boolean (true or false).' >&2; exit 1 ;;
  esac
fi
