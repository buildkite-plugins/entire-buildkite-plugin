#!/usr/bin/env bash
set -euo pipefail

if [[ $(uname -s) != Linux ]]; then
  echo 'Entire: automatic installation supports Linux only; install git-remote-entire on PATH first.' >&2
  exit 1
fi

case "$(uname -m)" in
  x86_64|amd64)
    arch=amd64
    checksum=e2d7e052b084e090cce91f08b64b965d9c9d12621071f7a87fc29be96bdc43a2 ;;
  aarch64|arm64)
    arch=arm64
    checksum=3f9c5e24dcc3f87d6acb58a526a1b71cb26d4c9075ce86054487451ff25b0c83 ;;
  *) echo "Entire: unsupported architecture: $(uname -m)" >&2; exit 1 ;;
esac

# Use the helper-only commit build selected by entire-core-auth-buildkite-plugin.
commit=57de2c37992efdbcc0519bda2376ccf93f3020c2
archive="$(mktemp)"
trap 'rm -f -- "$archive"' EXIT
curl -q --fail --silent --show-error --location --proto '=https' --proto-redir '=https' \
  --connect-timeout 15 --max-time 180 --retry 2 \
  "https://entire-public-release-bucket-7f3e2a01c9b48d56.s3.us-east-2.amazonaws.com/commit/${commit}/git-remote-entire_linux_${arch}.tar.gz" \
  --output "$archive"
printf '%s  %s\n' "$checksum" "$archive" \
  | sha256sum -c -s || { echo 'Entire: release checksum mismatch.' >&2; exit 1; }
mkdir -p "$HOME/.local/bin"
tar -xzf "$archive" -C "$HOME/.local/bin" git-remote-entire
